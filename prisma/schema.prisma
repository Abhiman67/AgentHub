generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(cuid())
  name                String
  email               String                @unique
  passwordHash        String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  profile             Profile?
  agents              Agent[]
  projects            Project[]
  conversations       Conversation[]
  files               File[]
  tasks               Task[]
  applications        Application[]
  approvals           Approval[]
  usageEvents         UsageEvent[]
  subscription        Subscription?
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]
  memberships         WorkspaceMember[]
  agentRuns           AgentRun[]
  toolCalls           ToolCall[]
  fileChunks          FileChunk[]
  integrationAccounts IntegrationAccount[]
  jobRecords          JobRecord[]
  recommendations     Recommendation[]
  subjects            Subject[]
  topics              Topic[]
  outcomes            LearningOutcome[]
  revisionSessions    RevisionSession[]
  milestones          Milestone[]
  projectRisks        ProjectRisk[]
  careerGoals         CareerGoal[]
  noteLinks           NoteLink[]
  noteRevisions       NoteRevision[]
  responsibilities    AgentResponsibility[]
  notifications       Notification[]
  masteryEvidence     MasteryEvidence[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    String?
  degree         String?
  semester       String?
  goals          Json     @default("[]")
  subjects       Json     @default("[]")
  skills         Json     @default("[]")
  interests      Json     @default("[]")
  studyHours     Int?
  careerTarget   String?
  onboardingDone Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model Agent {
  id               String                @id @default(cuid())
  ownerId          String?
  owner            User?                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template         String
  name             String
  role             String
  description      String
  icon             String                @default("sparkles")
  category         String
  systemPrompt     String
  createdAt        DateTime              @default(now())
  conversations    Conversation[]
  runs             AgentRun[]
  responsibilities AgentResponsibility[]

  @@unique([ownerId, template])
}

model Conversation {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title     String     @default("New conversation")
  projectId String?
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  messages  Message[]
  runs      AgentRun[]

  @@index([agentId])
  @@index([userId, projectId])
  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Project {
  id             String         @id @default(cuid())
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  description    String         @default("")
  type           String         @default("major")
  status         String         @default("active")
  targetDate     DateTime?
  linkedAgentIds Json           @default("[]")
  members        Json           @default("[]")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tasks          Task[]
  conversations  Conversation[]
  agentRuns      AgentRun[]
  milestones     Milestone[]
  risks          ProjectRisk[]
  files          File[]

  @@index([ownerId])
}

model Task {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title       String
  dueDate     DateTime?
  priority    String     @default("medium")
  status      String     @default("todo")
  agentId     String?
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  @@index([projectId, status, dueDate])
  @@index([subjectId, status, dueDate])
  @@index([milestoneId])
}

model File {
  id            String      @id @default(cuid())
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  mimeType      String
  size          Int
  status        String      @default("ready")
  textContent   String      @default("")
  storageKey    String?
  failureReason String?
  subjectId     String?
  subject       Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  careerGoalId  String?
  careerGoal    CareerGoal? @relation(fields: [careerGoalId], references: [id], onDelete: SetNull)
  folder        String      @default("Inbox")
  tags          Json        @default("[]")
  createdAt     DateTime    @default(now())
  chunks        FileChunk[]
  outgoingLinks NoteLink[]  @relation("NoteLinkFrom")
  incomingLinks NoteLink[]  @relation("NoteLinkTo")
  revisions     NoteRevision[]

  @@index([ownerId, status])
  @@index([ownerId, projectId])
  @@index([ownerId, careerGoalId])
}

model NoteLink {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fromId    String
  from      File     @relation("NoteLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        File     @relation("NoteLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  label     String   @default("")
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@index([ownerId, toId])
}

model NoteRevision {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())

  @@index([ownerId, fileId, createdAt])
}

model FileChunk {
  id        String   @id @default(cuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  index     Int
  content   String
  createdAt DateTime @default(now())

  @@unique([fileId, index])
  @@index([ownerId, fileId])
}

model IntegrationAccount {
  id                    String    @id @default(cuid())
  ownerId               String
  owner                 User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider              String
  scopes                Json      @default("[]")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([ownerId, provider])
  @@index([ownerId])
}

model JobRecord {
  id             String    @id @default(cuid())
  type           String
  idempotencyKey String    @unique
  payload        String    @default("{}")
  status         String    @default("queued")
  retries        Int       @default(0)
  maxRetries     Int       @default(3)
  nextAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User?     @relation(fields: [userId], references: [id])
  userId         String?

  @@index([type, status])
}

model Recommendation {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key         String
  kind        String
  title       String
  body        String    @default("")
  reason      String    @default("")
  sourceType  String    @default("")
  sourceId    String    @default("")
  sourceLabel String    @default("")
  href        String    @default("")
  status      String    @default("pending")
  feedback    String?
  snoozeUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownerId, key])
  @@index([ownerId, status])
}

model AgentResponsibility {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title        String
  instruction  String    @default("")
  triggerType  String    @default("schedule")
  triggerValue String    @default("daily")
  scopeIds     Json      @default("[]")
  actionPolicy String    @default("suggest_only")
  status       String    @default("active")
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, nextRunAt])
  @@index([ownerId, status])
}

model Notification {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  body       String    @default("")
  link       String    @default("")
  groupedKey String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId, readAt, createdAt])
  @@index([ownerId, groupedKey])
}

model Milestone {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    String    @default("todo")
  dueDate   DateTime?
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tasks     Task[]

  @@index([projectId, position])
}

model ProjectRisk {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  severity  String   @default("medium")
  status    String   @default("open")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

model CareerGoal {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title      String
  targetRole String    @default("")
  status     String    @default("active")
  deadline   DateTime?
  notes      String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  files      File[]

  @@index([ownerId, status])
}

model Subject {
  id        String            @id @default(cuid())
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  examDate  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  topics    Topic[]
  outcomes  LearningOutcome[]
  sessions  RevisionSession[]
  files     File[]
  tasks     Task[]

  @@index([ownerId, updatedAt])
}

model Topic {
  id        String            @id @default(cuid())
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  mastery   String            @default("unknown")
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  evidence  MasteryEvidence[]

  @@index([subjectId, position])
}

model LearningOutcome {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId   String?
  text      String
  createdAt DateTime @default(now())

  @@index([subjectId])
}

model RevisionSession {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title        String
  scheduledFor DateTime?
  durationMin  Int       @default(30)
  status       String    @default("planned")
  createdAt    DateTime  @default(now())

  @@index([subjectId, status])
}

model MasteryEvidence {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  kind      String
  score     Int?
  total     Int?
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([topicId, createdAt])
}

model Application {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  company   String
  role      String
  url       String   @default("")
  status    String   @default("saved")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
}

model Approval {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agentId     String
  title       String
  description String
  payload     String    @default("{}")
  status      String    @default("pending")
  runId       String?
  run         AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  toolCallId  String?
  toolCall    ToolCall? @relation(fields: [toolCallId], references: [id], onDelete: SetNull)
  risk        String    @default("workspace_write")
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([ownerId, status])
  @@index([runId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type      String
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@index([ownerId, type])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               String    @default("free")
  status             String    @default("active")
  provider           String?
  providerCustomerId String?   @unique
  providerSubId      String?   @unique
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  action    String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([action, createdAt])
}

model BillingEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String   @unique
  eventType       String
  receivedAt      DateTime @default(now())
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  invitations WorkspaceInvite[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("owner")
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId, role])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  tokenHash   String    @unique
  role        String    @default("member")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email, expiresAt])
}

model AgentRun {
  id               String        @id @default(cuid())
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agentId          String
  agent            Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationId   String?
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal             String
  status           String        @default("queued")
  currentStepIndex Int           @default(0)
  metadata         String        @default("{}")
  errorMessage     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  steps            AgentStep[]
  toolCalls        ToolCall[]
  approvals        Approval[]

  @@index([ownerId, status, updatedAt])
  @@index([conversationId])
  @@index([projectId])
}

model AgentStep {
  id               String     @id @default(cuid())
  runId            String
  run              AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence         Int
  kind             String
  title            String
  description      String     @default("")
  status           String     @default("queued")
  input            String?
  output           String?
  errorMessage     String?
  requiresApproval Boolean    @default(false)
  approvalId       String?
  createdAt        DateTime   @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  toolCalls        ToolCall[]

  @@index([runId, sequence])
}

model ToolCall {
  id           String     @id @default(cuid())
  runId        String?
  run          AgentRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  stepId       String?
  step         AgentStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  ownerId      String
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  toolName     String
  risk         String     @default("read_only")
  status       String     @default("queued")
  input        String     @default("{}")
  output       String?
  errorMessage String?
  createdAt    DateTime   @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  approvals    Approval[]

  @@index([ownerId, createdAt])
  @@index([runId, createdAt])
}
